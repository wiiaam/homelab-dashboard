package components

templ Tile(v TileView, oob string) {
	<div
		id={ TileID(v.Service) }
		class="rounded-xl border border-surface-hover bg-surface p-5 transition-colors hover:border-accent/40 hover:bg-surface-hover"
		if oob != "" {
			hx-swap-oob={ oob }
		}
	>
		<a href={ v.Service.URL } target="_blank" rel="noopener" class="flex flex-col items-center gap-3 text-center">
			<span class="text-3xl leading-none">{ v.Service.Icon }</span>
			<span class="text-sm font-medium">{ v.Service.Name }</span>
		</a>
		<p class="mt-4 border-t border-surface-hover pt-3 text-center text-xs tabular-nums text-muted">
			<span id={ MetricsID(v.Service) }>{ metricsText(v) }</span>
		</p>
	</div>
}